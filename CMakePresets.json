{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/Build/${presetName}"
    },
    {
      "name": "windows",
      "displayName": "Windows x64, Visual Studio (MSVC)",
      "description": "The supported product toolchain. No generator is named, so CMake uses the newest installed Visual Studio.",
      "inherits": "base",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux, GCC (development only)",
      "description": "Development build used to cross-check the code with a second compiler.",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux, Clang (development only)",
      "description": "Development build used to cross-check the code with a third compiler.",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux, GCC with AddressSanitizer and UBSan (development only)",
      "description": "Development build that runs the tests under the address, leak and undefined-behaviour sanitizers.",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "WW_SANITIZERS": "address;undefined"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "test-base",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "inherits": "test-base",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": "test-base",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    },
    {
      "name": "linux-clang-debug",
      "inherits": "test-base",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-sanitize",
      "inherits": "test-base",
      "configurePreset": "linux-sanitize",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows: configure, build and test (Debug)",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-debug"
        },
        {
          "type": "test",
          "name": "windows-debug"
        }
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows: configure, build and test (Release)",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows-release"
        },
        {
          "type": "test",
          "name": "windows-release"
        }
      ]
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC: configure, build and test (Debug)",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc"
        },
        {
          "type": "build",
          "name": "linux-gcc-debug"
        },
        {
          "type": "test",
          "name": "linux-gcc-debug"
        }
      ]
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC: configure, build and test (Release)",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc"
        },
        {
          "type": "build",
          "name": "linux-gcc-release"
        },
        {
          "type": "test",
          "name": "linux-gcc-release"
        }
      ]
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang: configure, build and test (Debug)",
      "steps": [
        {
          "type": "configure",
          "name": "linux-clang"
        },
        {
          "type": "build",
          "name": "linux-clang-debug"
        },
        {
          "type": "test",
          "name": "linux-clang-debug"
        }
      ]
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux GCC with sanitizers: configure, build and test (Debug)",
      "steps": [
        {
          "type": "configure",
          "name": "linux-sanitize"
        },
        {
          "type": "build",
          "name": "linux-sanitize"
        },
        {
          "type": "test",
          "name": "linux-sanitize"
        }
      ]
    }
  ]
}
