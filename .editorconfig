root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ follows the Epic C++ Coding Standard: tabs, four columns wide. Shaders are laid out like C++.
[*.{h,cpp,vert,frag,glsl}]
indent_style = tab
tab_width = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
